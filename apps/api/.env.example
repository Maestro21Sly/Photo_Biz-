# ---- Core ----
# Postgres connection. Docker-compose DB locally, or a hosted one (Neon/Supabase/RDS).
DATABASE_URL="postgresql://snapcampus:snapcampus@localhost:5432/snapcampus?schema=public"

# Auth secrets. Boot fails if these are shorter than 32 chars or look like a
# placeholder ("change-me", "dev-…"), so there is no way to ship the example values.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# Server
PORT="4000"
NODE_ENV="development"
# Comma-separated allowed origins. "*" is dev-only and is rejected when NODE_ENV=production.
CORS_ORIGIN="*"
# Reverse proxies in front of the API: "false" (none), a hop count ("1"), or a
# subnet/IP list. Wrong values either break rate limiting or let clients spoof it.
TRUST_PROXY="false"
# Public base URL of THIS API (used for locally-served uploads + links).
PUBLIC_BASE_URL="http://localhost:4000"
# Where the app/web lives — used to build email links (reset/verify).
APP_URL="http://localhost:8080"

# ---- Limits ----
# bcrypt cost. Minimum 10 outside tests.
BCRYPT_ROUNDS="12"
JSON_BODY_LIMIT="128kb"
MAX_UPLOAD_BYTES="15728640"
RATE_LIMIT_AUTH_PER_EMAIL="10"
RATE_LIMIT_AUTH_PER_IP="40"
RATE_LIMIT_TOKEN_PER_IP="60"
RATE_LIMIT_WRITE_PER_USER="30"
RATE_LIMIT_GLOBAL="300"

# ---- Object storage (portfolio photos / avatars) ----
# "local" stores under ./uploads (dev). "s3" uses an S3-compatible bucket
# (AWS S3, Cloudflare R2, Backblaze, MinIO). Production must use s3.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
# Set S3_ENDPOINT for R2/MinIO (e.g. https://<account>.r2.cloudflarestorage.com). Omit for AWS.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL / CDN domain for the bucket (e.g. https://cdn.snapcampus.app).
S3_PUBLIC_URL=""

# ---- Email (password reset, verification) ----
# "console" logs emails to the server log (dev) and is rejected in production.
EMAIL_DRIVER="console"
EMAIL_FROM="SnapCampus <noreply@snapcampus.app>"
RESEND_API_KEY=""
