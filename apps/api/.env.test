# Test configuration. Committed on purpose: these are throwaway values for a
# throwaway database, and CI needs them. Anything already exported in the
# environment (e.g. CI's DATABASE_URL) wins — dotenv never overrides.
NODE_ENV="test"
DATABASE_URL="postgresql://snapcampus:snapcampus@localhost:5432/snapcampus_test?schema=public"

JWT_ACCESS_SECRET="test-only-access-key-0123456789abcdef0123456789abcdef"
JWT_REFRESH_SECRET="test-only-refresh-key-fedcba9876543210fedcba9876543210"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

PORT="4010"
CORS_ORIGIN="http://localhost:8081,https://app.snapcampus.test"
TRUST_PROXY="false"
PUBLIC_BASE_URL="http://localhost:4010"
APP_URL="http://localhost:8080"

# bcrypt at cost 12 would add minutes to the suite; the hashing itself is
# covered by asserting round-trips, not by the cost factor.
BCRYPT_ROUNDS="4"
# Suites that don't assert on throttling would otherwise trip the shared
# counters; tests/ratelimit.test.ts re-enables this for itself.
RATE_LIMIT_DISABLED="true"

STORAGE_DRIVER="local"
EMAIL_DRIVER="console"
